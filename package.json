{
  "name": "website-mobil-bekas",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "db"
  ],
  "scripts": {
    "dev": "bun run --filter web --filter api --parallel dev",
    "build": "bun run --filter '*' --if-present build",
    "lint": "bun fmt --check api db web",
    "typecheck": "bun run --filter '*' --if-present typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.7.0"
  }
}
