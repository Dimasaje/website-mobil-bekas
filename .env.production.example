# Salin ke .env di VPS (jangan di-commit), lalu sesuaikan nilainya.
# docker compose membaca .env otomatis dari folder ini.

# --- Domain & publikasi ---
# Domain tanpa protokol; dipakai Caddy untuk menerbitkan sertifikat HTTPS.
SITE_DOMAIN=bintangmobil.co.id
# URL publik lengkap, dipakai canonical/Open Graph/sitemap.
SITE_URL=https://bintangmobil.co.id
SHOWROOM_NAME=Bintang Mobil

# --- Database (postgres di dalam compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=website_mobil_bekas

# --- Admin awal ---
# Dipakai hanya saat SEED_ON_START=true pada boot pertama.
ADMIN_EMAIL=admin@bintangmobil.co.id
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_NAME=Admin Bintang Mobil
# Set true sekali saat instalasi awal, lalu kembalikan ke false.
SEED_ON_START=false

# --- Backup ---
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
