# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
# Catatan: Karakter khusus pada password harus di-URL-encode (contoh: @ jadi %40)
DATABASE_URL=postgres://postgres:password@localhost:5432/website_mobil_bekas

# Server Port
PORT=3001
VITE_PORT=3000

# Origin publik untuk canonical, Open Graph, dan sitemap.
SITE_URL=http://localhost:3000

# Folder hasil build frontend yang disajikan API. Default: web/dist di repo.
# WEB_DIST_DIR=C:\path\ke\web\dist
